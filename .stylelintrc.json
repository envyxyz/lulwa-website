{
  "customSyntax": "postcss-html",
  "overrides": [
    { "files": ["**/*.css"], "customSyntax": null },
    {
      "files": ["src/styles/tokens.css"],
      "rules": { "color-no-hex": null, "declaration-property-value-disallowed-list": null, "function-disallowed-list": null }
    }
  ],
  "rules": {
    "color-no-hex": true,
    "color-named": null,
    "function-disallowed-list": ["linear-gradient", "radial-gradient", "conic-gradient", "rgb", "rgba", "hsl", "hsla"],
    "property-disallowed-list": [
      "margin-left", "margin-right", "padding-left", "padding-right", "left", "right",
      "border-left", "border-right", "border-left-width", "border-right-width", "border-left-color", "border-right-color",
      "border-top-left-radius", "border-top-right-radius", "border-bottom-left-radius", "border-bottom-right-radius",
      "backdrop-filter"
    ],
    "declaration-property-value-disallowed-list": {
      "text-align": ["left", "right"],
      "float": ["left", "right"],
      "clear": ["left", "right"],
      "box-shadow": ["/^(?!none$|var\\(--shadow-menu\\)$).+/"],
      "border-radius": ["/^(?!0$|var\\(--radius-).+/"]
    }
  }
}
