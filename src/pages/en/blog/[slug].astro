---
import Page from '../../../components/Page.astro';
import { en } from '../../../content/en';
import { isEnglishRoot } from '../../../content';

export const getStaticPaths = () => en.blog.items.filter((i) => !isEnglishRoot(`/blog/${i.slug}`)).map((i) => ({ params: { slug: i.slug } }));
const { slug } = Astro.params;
---

<Page kind="post" slug={slug} />
