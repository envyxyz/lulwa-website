---
import AskPage from '../../../components/AskPage.astro';
import Page from '../../../components/Page.astro';
import { ar } from '../../../content/ar';

export const getStaticPaths = () => ar.areas.items.map((i) => ({ params: { slug: i.slug } }));
const slug = Astro.params.slug!;
---

{slug === 'appliance-repair-in-dammam' ? <Page kind="area" slug={slug} /> : <AskPage kind="area" slug={slug} />}
