---
import { site } from '../site';
import { content, langFromUrl, localePath } from '../content';

const lang = langFromUrl(Astro.url);
const c = content[lang];
const { form } = c.contact;
const field = 'min-h-target w-full rounded-button bg-pearl-step px-card py-2 text-body transition focus:bg-pearl-hover aria-invalid:outline-2 aria-invalid:-outline-offset-2 aria-invalid:outline-error';
const label = 'flex flex-col gap-1 font-medium';
const error = 'text-small text-error';
const fields = [
  { name: 'name', type: 'text', label: form.name, autocomplete: 'name' },
  { name: 'phone', type: 'tel', label: form.phone, autocomplete: 'tel' },
] as const;
---

<form
  id="lead-form"
  novalidate
  class="flex max-w-prose flex-col gap-4"
  data-endpoint="/api/lead"
  data-thanks={localePath(lang, '/thanks')}
  data-whatsapp={site.phone.whatsapp}
  data-errors={JSON.stringify(form.errors)}
>
  {fields.map((f) => (
    <label class={label}>
      {f.label}
      <input class={field} name={f.name} type={f.type} autocomplete={f.autocomplete} required maxlength="80" inputmode={f.type === 'tel' ? 'tel' : undefined} dir={f.type === 'tel' ? 'ltr' : undefined} aria-describedby={`${f.name}-error`} />
      <span id={`${f.name}-error`} class={error} data-error-for={f.name} hidden></span>
    </label>
  ))}
  <label class={label}>
    {form.appliance}
    <select class={field} name="appliance" required aria-describedby="appliance-error">
      <option value="">{form.choose}</option>
      {c.home.picker.appliances.map((a) => <option value={a.name}>{a.name}</option>)}
    </select>
    <span id="appliance-error" class={error} data-error-for="appliance" hidden></span>
  </label>
  <label class={label}>
    {form.area}
    <input class={field} name="area" type="text" required maxlength="60" aria-describedby="area-error" />
    <span id="area-error" class={error} data-error-for="area" hidden></span>
  </label>
  <label class={label}>
    {form.message}
    <textarea class={`${field} min-h-32`} name="message" rows="4" maxlength="1000"></textarea>
  </label>
  <!-- Honeypot: off screen and out of the tab order. People never see it. -->
  <input name="website" type="text" hidden tabindex="-1" autocomplete="off" />
  <p data-consent class="text-small text-ink-soft">{form.consent} <a class="underline underline-offset-4" href={localePath(lang, '/privacy-policy')}>{form.privacy}</a></p>
  <button type="submit" data-sending={form.sending} class="inline-flex h-button md:h-button-md items-center gap-2 rounded-button bg-teal px-card font-medium text-pearl transition hover:bg-teal-active active:scale-98 active:bg-teal-active cursor-pointer disabled:cursor-wait disabled:opacity-70 self-start"><span data-spinner hidden class="spinner"></span><span data-label>{form.submit}</span></button>
  <div role="status" class="flex flex-col items-start gap-2" data-status>
    <p data-fallback-text hidden class="font-medium text-error">{form.fallback}</p>
    <a data-fallback-link data-action="whatsapp" hidden class="inline-flex min-h-target items-center rounded-button bg-whatsapp px-card font-medium text-white transition active:scale-98 active:bg-whatsapp-active" href={site.phone.whatsapp}>{form.whatsappFallback}</a>
  </div>
</form>

<script>
  import { sourceTag, slug, campaign, track } from '../scripts/track';

  const form = document.querySelector<HTMLFormElement>('#lead-form')!;
  const errors = JSON.parse(form.dataset.errors!) as Record<string, string>;
  const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
  const show = (name: string, message: string) => {
    const el = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`)!;
    el.textContent = message;
    el.hidden = !message;
    field(name).setAttribute('aria-invalid', String(Boolean(message)));
  };

  const validate = (name: string) => {
    const value = field(name).value.trim();
    let message = '';
    if (!value) message = errors.required!;
    else if (name === 'phone' && !/^\d{8,15}$/.test(value.replace(/[\s-]|^\+/g, ''))) message = errors.phone!;
    show(name, message);
    return message;
  };
  const names = ['name', 'phone', 'appliance', 'area'];
  const check = () => names.filter((name) => validate(name));
  // Check a field as people leave it; once it has errored, keep checking as they fix it.
  for (const name of names) {
    field(name).addEventListener('blur', () => validate(name));
    for (const type of ['input', 'change']) field(name).addEventListener(type, () => field(name).getAttribute('aria-invalid') === 'true' && validate(name));
  }

  const busy = (on: boolean) => {
    button.disabled = on;
    button.toggleAttribute('aria-busy', on);
    button.querySelector<HTMLElement>('[data-spinner]')!.hidden = !on;
    button.querySelector<HTMLElement>('[data-label]')!.textContent = on ? button.dataset.sending! : label;
  };
  const label = button.querySelector<HTMLElement>('[data-label]')!.textContent!;
  addEventListener('pageshow', () => busy(false));

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const bad = check();
    if (bad.length) return field(bad[0]!).focus();
    busy(true);
    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    const lead = { name: data.name, phone: data.phone, appliance: data.appliance, area: data.area, message: data.message ?? '', website: data.website ?? '', page: slug(), utm: campaign() };
    let whatsapp = '';
    try {
      const response = await fetch(form.dataset.endpoint!, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(lead) });
      const out = (await response.json().catch(() => ({}))) as { ok?: boolean; whatsapp?: string };
      if (response.ok && out.ok) {
        track('lead_submit');
        return void location.assign(form.dataset.thanks!);
      }
      whatsapp = out.whatsapp ?? '';
    } catch {
      // Offline or the Worker is down: fall through to WhatsApp.
    }
    // The Sheet failed: typed values stay, and the WhatsApp link carries the message.
    const text = `${lead.appliance}, ${lead.area}. ${lead.message} ${sourceTag()}`.replace(/\s+/g, ' ').trim();
    const link = form.querySelector<HTMLAnchorElement>('[data-fallback-link]')!;
    link.href = whatsapp || `${form.dataset.whatsapp}?text=${encodeURIComponent(text)}`;
    link.hidden = false;
    form.querySelector<HTMLElement>('[data-fallback-text]')!.hidden = false;
    busy(false);
    link.focus();
  });
</script>

<style>
  [data-error-for]:not([hidden]) {
    animation: error-in var(--duration-open) var(--ease-out);
  }
  @keyframes error-in {
    from {
      opacity: 0;
      translate: 0 -0.25rem;
    }
  }
  .spinner {
    inline-size: 1em;
    block-size: 1em;
    border: 2px solid currentColor;
    border-block-start-color: transparent;
    border-radius: var(--radius-dot);
    animation: spin calc(var(--duration-rise) * 1.6) linear infinite;
  }
  @keyframes spin {
    to {
      rotate: 1turn;
    }
  }
</style>
