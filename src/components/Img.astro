---
// Files come from the Phase 4 image pipeline: /images/<name>-<width>.avif and .webp.
// `width` is the largest export, so a photo never renders past its source. Below the fold by default.
type Props = { name: string; widths: number[]; width: number; height: number; alt: string; sizes?: string; eager?: boolean; rounded?: boolean; job?: boolean };
const { name, widths, width, height, alt, sizes = '100vw', eager = false, rounded = false, job = false } = Astro.props;
const srcset = (ext: string) => widths.map((w) => `/images/${name}-${w}.${ext} ${w}w`).join(', ');
---

<picture class:list={['skeleton', rounded && 'rounded-card']} style={`aspect-ratio:${width}/${height};max-inline-size:${width}px`}>
  <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
  <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
  <img
    src={`/images/${name}-${width}.webp`}
    width={width}
    height={height}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
    data-job={job || undefined}
    style={`max-inline-size:${width}px`}
    class:list={['h-auto w-full', rounded && 'rounded-card']}
  />
</picture>
