---
import { site } from '../site';
import { content, langFromUrl } from '../content';

// The Google Business Profile map. Google's map weighs about 500 KB, so it loads only once it is on screen.
const lang = langFromUrl(Astro.url);
const attrs = { title: content[lang].home.shop.mapTitle, referrerpolicy: 'no-referrer-when-downgrade', class: 'aspect-square w-full rounded-card bg-pearl md:col-span-2 md:aspect-video' } as const;
const src = `${site.maps.embed}&hl=${lang}`;
---

<iframe data-shop-map data-src={src} {...attrs}></iframe>
<noscript><iframe src={src} {...attrs}></iframe></noscript>

<script>
  const map = document.querySelector<HTMLIFrameElement>('[data-shop-map]')!;
  new IntersectionObserver(([entry], watch) => {
    if (!entry!.isIntersecting) return;
    map.src = map.dataset.src!;
    watch.disconnect();
  }).observe(map);
</script>
