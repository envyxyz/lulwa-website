---
import { ArrowRight, BadgeCheck, Camera, ChevronRight, CircleCheck, Clock, MapPin, Menu, MousePointerClick, Pause, Phone, Play, Star, X } from 'lucide-static';
import { siWhatsapp } from 'simple-icons';

export type IconName = keyof typeof lucide | 'whatsapp';
const lucide = { 'arrow-next': ArrowRight, 'chevron-next': ChevronRight, 'badge-check': BadgeCheck, camera: Camera, 'circle-check': CircleCheck, clock: Clock, pointer: MousePointerClick, star: Star, 'map-pin': MapPin, menu: Menu, pause: Pause, phone: Phone, play: Play, close: X };
// Only these flip in RTL. Logo, phone and WhatsApp glyphs never do.
const directional = new Set<string>(['arrow-next', 'chevron-next']);

type Props = { name: IconName; label?: string; small?: boolean };
const { name, label, small } = Astro.props;
const svg =
  name === 'whatsapp'
    ? `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="${siWhatsapp.path}"/></svg>`
    : lucide[name].replace(/stroke-width="[^"]*"/, 'stroke-width="1.75"');
const isDirectional = directional.has(name);
---

<span
  class:list={['inline-block shrink-0 *:size-full', small ? 'size-icon-sm' : 'size-icon', isDirectional && 'rtl:-scale-x-100']}
  data-icon={name}
  data-directional={isDirectional || undefined}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={svg}
/>
