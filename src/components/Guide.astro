---
import Faq from './Faq.astro';
import Heading from './Heading.astro';
import Section from './Section.astro';
import Text from './Text.astro';
import { site } from '../site';
import { content, langFromUrl } from '../content';
import type { Guide } from '../content/types';

// The long-form body of a ranking page: h2 sections, optional h3 items, then the FAQ. Renders nothing without a guide.
type Props = { guide?: Guide | undefined };
const { guide } = Astro.props;
const lang = langFromUrl(Astro.url);
const { ask } = content[lang];
// Digits and Latin names read in their own direction inside Arabic text (rule 8).
const bdi = (t: string) => t.replaceAll(site.phone.display, `<bdi dir="ltr">${site.phone.display}</bdi>`);
---

{guide && guide.sections.length > 0 && (
  <Section>
    <article data-guide class="flex max-w-prose flex-col gap-10">
      {guide.sections.map((s) => (
        <section class="flex flex-col gap-3">
          <Heading level={2} size="lead">{s.h}</Heading>
          {s.p.map((t) => <Text><Fragment set:html={bdi(t)} /></Text>)}
          {s.image && <img src={s.image.src} width={s.image.width} height={s.image.height} alt={s.image.alt} loading="lazy" decoding="async" class="h-auto max-w-full rounded-card" />}
          {s.items && s.items.length > 0 && (
            <div class="mt-2 flex flex-col gap-4">
              {s.items.map((i) => (
                <div class="flex flex-col gap-1 rounded-card bg-pearl-step p-card">
                  <h3 class="font-display text-body font-head">{i.h}</h3>
                  <p class="text-body text-ink-soft"><Fragment set:html={bdi(i.p)} /></p>
                </div>
              ))}
            </div>
          )}
        </section>
      ))}
    </article>
  </Section>
)}
{guide && guide.faq.length > 0 && (
  <Section>
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-4"><Heading level={2}>{ask.faq}</Heading></div>
      <div class="lg:col-span-7"><Faq items={guide.faq} /></div>
    </div>
  </Section>
)}
