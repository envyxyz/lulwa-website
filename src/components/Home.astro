---
import Button from './Button.astro';
import Faq from './Faq.astro';
import Guide from './Guide.astro';
import Heading from './Heading.astro';
import Icon from './Icon.astro';
import Img from './Img.astro';
import Picker from './Picker.astro';
import Reviews from './Reviews.astro';
import Section from './Section.astro';
import ShopMap from './ShopMap.astro';
import Text from './Text.astro';
import { art } from './appliance-art';
import provenance from '../images/provenance.json';
import { site } from '../site';
import { content, langFromUrl, localePath } from '../content';
import { guide } from '../content/guides';

const lang = langFromUrl(Astro.url);
const { actions, home, reviews, services } = content[lang];
const { repair, statement, steps, work, shop, faq, close } = home;
const g = guide('page', '/', lang);

// Generated image when it exists, line drawing until then. scripts/images.mjs adds it to provenance.
const cardArt: Record<string, { image: string; drawing: string }> = {
  'ac-repair': { image: 'window-ac', drawing: 'window-ac' },
  'refrigerator-repair': { image: 'fridge', drawing: 'fridge' },
  'washing-machine-repair': { image: 'washer', drawing: 'washer' },
  'dryer-repair': { image: 'dryer', drawing: 'dryer' },
};
const step = 'inline-flex size-target cursor-pointer items-center justify-center rounded-button bg-pearl-step text-teal transition hover:bg-pearl-hover active:scale-98 disabled:opacity-40 disabled:hover:bg-pearl-step disabled:active:scale-100';
const hasImage = (name: string) => name in provenance;

// Portrait photos are 287 wide, landscape 680: the grid never pushes them past that (Img caps it).
const size = (photo: string) => (provenance as Record<string, { sourceWidth: number }>)[photo]!.sourceWidth;
const photo = (name: string) => work.items.find((w) => w.photo === name)!;
const wall = [
  { name: 'compressor-install', span: 'lg:col-span-3 lg:row-span-2' },
  { name: 'rooftop-compressor-swap', span: 'col-span-2 lg:col-span-6' },
  { name: 'compressor-closeup-2', span: 'lg:col-span-3 lg:row-span-2' },
  { name: 'statement', span: 'col-span-2 lg:col-span-6' },
  { name: 'compressor-pair', span: 'lg:col-span-3' },
  { name: 'rooftop-unit-repair', span: 'col-span-2 lg:col-span-6' },
  { name: 'condensing-unit-wiring', span: 'lg:col-span-3' },
];
---

<div id="pick"><Picker /></div>

<section class="pt-section">
  <div class="mx-auto flex max-w-page flex-col items-start gap-4 px-gutter">
    <Heading>{repair.heading}<Fragment slot="quiet">{repair.quiet}</Fragment></Heading>
    <Text>{repair.lead}</Text>
  </div>
  <div class="mx-auto mt-4 hidden max-w-page justify-end gap-2 px-gutter md:flex xl:hidden">
    <button type="button" data-step="-1" disabled aria-label={repair.prev} class={step}><span class="flex -scale-x-100"><Icon name="arrow-next" /></span></button>
    <button type="button" data-step="1" aria-label={repair.next} class={step}><Icon name="arrow-next" /></button>
  </div>
  <div data-row class="mx-auto mt-4 flex max-w-page snap-x snap-mandatory gap-4 overflow-x-auto px-gutter pb-2">
    <div class="flex w-tile shrink-0 snap-start flex-col justify-between gap-8 rounded-card bg-teal p-4 text-pearl xl:w-auto xl:min-w-0 xl:flex-1" data-tone="teal">
      <p class="font-display text-head font-head">{repair.callLabel}</p>
      <Button variant="call" light><bdi dir="ltr" class="whitespace-nowrap">{site.phone.display}</bdi></Button>
    </div>
    {services.items.map((s) => {
      const a = cardArt[s.slug]!;
      return (
        <a href={localePath(lang, `/services/${s.slug}`)} class="flex w-tile shrink-0 snap-start flex-col gap-2 rounded-card bg-pearl-step p-4 transition hover:bg-pearl-hover active:scale-98 xl:w-auto xl:min-w-0 xl:flex-1">
          <span class="font-display text-lead font-head">{s.name}</span>
          <span class="grow text-small text-ink-soft">{s.summary}</span>
          <span class="mt-2 block p-2">
            {hasImage(a.image)
              ? <Img name={a.image} widths={[320, 640]} width={640} height={478} alt="" sizes="16rem" />
              : <svg viewBox="0 0 200 150" aria-hidden="true" class="h-auto w-full fill-none stroke-teal stroke-2" set:html={art[a.drawing]!.svg} />}
          </span>
          <span class="flex justify-end text-teal"><Icon name="arrow-next" /></span>
        </a>
      );
    })}
  </div>
</section>

<div class="px-gutter pt-section">
  <p class="mx-auto max-w-page rounded-panel bg-pearl-step p-card text-center font-display text-panel font-head">
    {statement.start} <span class="text-teal">{statement.quiet}</span>
  </p>
</div>

<div class="pt-section">
  <Section tone="ink">
    <div class="flex flex-col gap-12">
      <Heading tone="pearl">{steps.heading}</Heading>
      <ol class="grid md:grid-cols-3">
        {steps.items.map((s, i) => {
          const last = i === steps.items.length - 1;
          const href = [`#pick`, site.phone.whatsapp][i];
          return (
            <li class:list={['group flex gap-4 md:flex-col md:gap-0', !last && 'pb-8 md:pb-0']}>
              <div class:list={['flex flex-col items-center md:mb-0 md:flex-row', !last && '-mb-8']}>
                <span class:list={['rail hidden md:flex', i === 0 && 'invisible']} style={`--seg:${i * 2 - 1}`} aria-hidden="true"><span class="rail-fill"></span></span>
                <span class="inline-flex size-node shrink-0 items-center justify-center rounded-dot bg-ink-step text-head text-pearl transition group-focus-within:bg-teal group-hover:bg-teal motion-safe:group-focus-within:-translate-y-1 motion-safe:group-hover:-translate-y-1" aria-hidden="true"><Icon name={['pointer', 'camera', 'circle-check'][i] as 'pointer'} /></span>
                <span class:list={['rail', last && 'invisible']} style={`--seg:${i * 2}`} aria-hidden="true"><span class="rail-fill"></span></span>
              </div>
              <p class="flex min-h-node items-center font-display text-lead font-head transition md:min-h-0 md:justify-center md:px-4 md:pt-6 md:text-center motion-safe:group-focus-within:-translate-y-1 motion-safe:group-hover:-translate-y-1">
                <span>{s.before}{s.link && <a href={href} data-action={i === 1 ? 'whatsapp' : undefined} data-scroll={i === 0 ? 'pick' : undefined} class="underline decoration-2 underline-offset-4 transition hover:text-teal-quiet">{s.link}</a>}{s.after}</span>
              </p>
            </li>
          );
        })}
      </ol>
    </div>
  </Section>
</div>

<Section>
  <div class="flex flex-col gap-8">
    <div class="flex flex-col items-start gap-4">
      <Heading>{home.reviews.heading}<Fragment slot="quiet">{home.reviews.quiet}</Fragment></Heading>
      <Text>{reviews.lead}</Text>
    </div>
    <Reviews />
  </div>
</Section>

<Section tone="teal">
  <div class="flex flex-col gap-8">
    <div class="flex flex-col items-start gap-4">
      <Heading tone="pearl">{work.heading}<Fragment slot="quiet">{work.quiet}</Fragment></Heading>
      <Text>{work.lead}</Text>
    </div>
    <div class="grid grid-flow-dense grid-cols-2 gap-4 lg:grid-cols-12">
      {wall.map(({ name, span }) =>
        name === 'statement' ? (
          <p class:list={['flex items-center rounded-card bg-teal-step p-card font-display text-head font-head', span]}>{work.statement}</p>
        ) : (
          <figure class:list={['flex flex-col gap-2', span]}>
            <Img name={name} widths={size(name) > 400 ? [340, size(name)] : [size(name)]} width={size(name)} height={size(name) > 400 ? 382 : 510} alt={photo(name).caption} sizes="(min-width: 64rem) 40vw, 50vw" rounded job />
            <figcaption class="text-small">{photo(name).caption}</figcaption>
          </figure>
        ),
      )}
    </div>
  </div>
</Section>

<Section>
  <div class="grid gap-8 rounded-panel bg-pearl-step p-card md:grid-cols-2">
    <div class="flex flex-col items-start gap-4">
      <Heading>{shop.heading}</Heading>
      <dl class="flex flex-col gap-4">
        <div><dt class="text-small text-ink-soft">{shop.addressLabel}</dt><dd class="font-display text-lead font-head">{shop.address}</dd></div>
        <div><dt class="text-small text-ink-soft">{shop.legalLabel}</dt><dd>{site.legal.name}</dd></div>
        <div><dt class="text-small text-ink-soft">{shop.crLabel}</dt><dd><bdi>{site.legal.cr}</bdi></dd></div>
      </dl>
      <Button variant="quiet" href={site.maps.listing} data-action="directions">{actions.directions}</Button>
    </div>
    <table class="self-start">
      <caption class="text-start text-small text-ink-soft">{shop.hoursLabel}</caption>
      <tbody>
        {shop.days.map((day, i) => (
          <tr data-day={i}>
            <th scope="row" class="whitespace-nowrap py-1 pe-4 text-start font-regular">{day}<span data-today hidden class="sr-only font-medium sm:not-sr-only"> · {shop.today}</span></th>
            <td class="whitespace-nowrap py-1 text-small"><bdi>{shop.hoursRange}</bdi></td>
          </tr>
        ))}
      </tbody>
    </table>
    <ShopMap />
  </div>
</Section>

<Guide guide={g && { ...g, faq: [] }} />

<Section>
  <div class="grid gap-8 lg:grid-cols-12">
    <div class="flex flex-col items-start gap-4 lg:col-span-4">
      <Heading>{faq.heading}<Fragment slot="quiet">{faq.quiet}</Fragment></Heading>
      <Text>{faq.lead}</Text>
      <Button variant="whatsapp">{faq.cta}</Button>
    </div>
    <div class="lg:col-span-8"><Faq items={[...faq.items, ...(g?.faq ?? [])]} /></div>
  </div>
</Section>

<div class="px-gutter pb-section">
  <div data-tone="teal" class="mx-auto flex max-w-page flex-col gap-4 rounded-panel bg-teal p-card text-pearl md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="font-display text-head font-head">{close.heading}</h2>
      <p>{close.text}</p>
    </div>
    <div class="flex flex-wrap gap-3 *:grow md:*:grow-0">
      <Button variant="whatsapp">{actions.whatsapp}</Button>
      <Button variant="call" light>{actions.call}</Button>
    </div>
  </div>
</div>

<script>
  // "Select" glides to the picker; without this the plain #pick link still jumps there.
  document.querySelector<HTMLAnchorElement>('[data-scroll]')?.addEventListener('click', (event) => {
    event.preventDefault();
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.getElementById('pick')?.scrollIntoView({ behavior: calm ? 'auto' : 'smooth' });
  });

  // Today in the shop's time zone.
  const today = new Date(Date.now() + 3 * 3600_000).getUTCDay();
  const row = document.querySelector<HTMLElement>(`[data-day="${today}"]`);
  row?.setAttribute('aria-current', 'date');
  row?.querySelector<HTMLElement>('[data-today]')?.removeAttribute('hidden');

  // Service row arrows: one card per press, the ends disable themselves. scrollLeft is negative in RTL.
  const track = document.querySelector<HTMLElement>('[data-row]')!;
  const steps = document.querySelectorAll<HTMLButtonElement>('[data-step]');
  const edges = () => {
    const x = Math.abs(track.scrollLeft);
    steps[0]!.disabled = x < 1;
    steps[1]!.disabled = x + track.clientWidth >= track.scrollWidth - 1;
  };
  steps.forEach((b) =>
    b.addEventListener('click', () => {
      const w = track.firstElementChild!.getBoundingClientRect().width;
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const dir = getComputedStyle(track).direction === 'rtl' ? -1 : 1;
      track.scrollBy({ left: Number(b.dataset.step) * dir * w, behavior: calm ? 'auto' : 'smooth' });
    }),
  );
  track.addEventListener('scroll', edges, { passive: true });
  edges();
</script>

<style>
  /* Today's row in the opening hours (the script sets aria-current): teal and medium, whether or not the "Today" word shows. */
  [data-day][aria-current] > * {
    color: var(--color-teal);
    font-weight: var(--font-weight-medium);
  }
  /* The connector between step nodes: a track with a teal fill that draws in as the diagram scrolls into view.
     Fully drawn by default, so nothing is hidden when scroll-driven animation is missing or reduced motion is on. */
  .rail {
    position: relative;
    flex: 1;
    inline-size: var(--spacing-rail);
    background: var(--color-ink-step);
  }
  .rail-fill {
    position: absolute;
    inset: 0;
    background: var(--color-teal);
  }
  @media (min-width: 48rem) {
    .rail {
      inline-size: auto;
      block-size: var(--spacing-rail);
    }
  }
  @keyframes draw-y {
    from {
      block-size: 0;
      inset-block-end: auto;
    }
  }
  @keyframes draw-x {
    from {
      inline-size: 0;
      inset-inline-end: auto;
    }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .rail-fill {
        /* Longhands on purpose: the minifier folds a view() timeline into the animation shorthand, which browsers drop. */
        animation-name: draw-y;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 5% cover 25%;
      }
      @media (min-width: 48rem) {
        .rail-fill {
          animation-name: draw-x;
          /* Four segments in a row, each drawing right after the one before. */
          animation-range: cover calc(5% + var(--seg) * 8%) cover calc(5% + var(--seg) * 8% + 12%);
        }
      }
    }
  }
</style>
