---
import Button from './Button.astro';
import Guide from './Guide.astro';
import Heading from './Heading.astro';
import Img from './Img.astro';
import LeadForm from './LeadForm.astro';
import Reviews from './Reviews.astro';
import Section from './Section.astro';
import ShopMap from './ShopMap.astro';
import Text from './Text.astro';
import Base from '../layouts/Base.astro';
import provenance from '../images/provenance.json';
import { site } from '../site';
import { content, langFromUrl, localePath } from '../content';
import { article, faqPage } from '../seo';
import { guide } from '../content/guides';
import type { Intro, Section as Block } from '../content/types';

// One template for the plain pages: intro, then the body for its kind.
type Props = {
  kind: 'about' | 'areas' | 'area' | 'brands' | 'contact' | 'reviews' | 'work' | 'privacy' | 'terms' | 'cookies' | 'blog' | 'post' | 'notFound' | 'thanks';
  slug?: string;
};
const lang = langFromUrl(Astro.url);
const c = content[lang];
const { actions, home } = c;
const { kind, slug } = Astro.props;

const legal = { privacy: c.legal.privacy, terms: c.legal.terms, cookies: c.legal.cookies };
const doc: (Intro & { sections?: Block[]; updated?: string }) | undefined =
  kind === 'area' ? c.areas.items.find((i) => i.slug === slug)
  : kind === 'post' ? c.blog.items.find((i) => i.slug === slug)
  : kind === 'privacy' || kind === 'terms' || kind === 'cookies' ? legal[kind]
  : undefined;
const intro: Intro = doc ?? (c as unknown as Record<string, Intro>)[kind]!;
const sections = doc?.sections ?? (kind === 'about' ? c.about.sections : []);

const g = kind === 'area' || kind === 'post' ? guide(kind, slug!, lang) : guide('page', `/${kind === 'about' ? 'about' : kind}`, lang);
const photos = home.work.items;
// Every real job photo, none hidden. A photo never renders past its source width (rule 15; Img caps it): portraits are 287 wide, landscapes 680.
const sizeOf = (name: string) => (provenance as Record<string, { sourceWidth: number }>)[name]!.sourceWidth;
const rows = [
  [home.shop.addressLabel, home.shop.address],
  [home.shop.hoursLabel, home.shop.hours],
];
const long = kind === 'area' || kind === 'post' || kind === 'privacy' || kind === 'terms' || kind === 'cookies' || kind === 'notFound';
const needsNext = !['notFound', 'contact', 'reviews', 'post'].includes(kind);
// The phone number reads left to right inside Arabic text (rule 8).
const bdi = (t: string) => t.replaceAll(site.phone.display, `<bdi dir="ltr">${site.phone.display}</bdi>`);
const chip = 'flex h-full min-h-target flex-col justify-center gap-1 rounded-card bg-pearl-step px-card py-3 font-medium transition hover:bg-pearl-hover active:scale-98';
const tile = 'flex min-h-target flex-col gap-2 rounded-card bg-pearl-step p-card font-display text-lead font-head transition hover:bg-pearl-hover active:scale-98';
---

<Base title={intro.seo.title} description={intro.seo.description} noindex={kind === 'thanks'} ld={[...(kind === 'post' ? [article(intro.h1, intro.seo.description, doc?.updated ?? '', lang)] : []), ...(g?.faq.length ? [faqPage(g.faq)] : [])]}>
  <Section>
    <div class="flex flex-col items-start gap-4">
      <Heading level={1} size={long ? 'head' : 'statement'}>{intro.h1}</Heading>
      <Text size="lead">{intro.lead}</Text>
      {(kind === 'notFound' || kind === 'thanks' || kind === 'area' || kind === 'contact' || kind === 'brands') && (
        <div class="flex flex-wrap gap-3"><Button variant="whatsapp">{actions.whatsapp}</Button><Button variant="call">{actions.call}</Button></div>
      )}
      {needsNext && <Button variant="quiet" href={localePath(lang, '/services')}>{actions.allServices}</Button>}
      {kind === 'area' && <Button variant="quiet" href={localePath(lang, '/areas')}>{c.areas.h1}</Button>}
      {kind === 'notFound' && <Button variant="quiet" href={localePath(lang, '/')}>{c.notFound.home}</Button>}
      {doc?.updated && <Text soft>{c.blog.updated}: {doc.updated}</Text>}
    </div>
  </Section>

  {sections.length > 0 && (
    <Section>
      <div class="flex max-w-prose flex-col gap-8">
        {sections.map((s) => <div class="flex flex-col gap-2"><Heading level={2}>{s.h}</Heading><Text><Fragment set:html={bdi(s.body)} /></Text></div>)}
      </div>
    </Section>
  )}

  {kind === 'about' && (
    <Section tone="teal">
      <div class="flex flex-col gap-6">
        <Heading level={2} tone="pearl">{c.about.factsHeading}</Heading>
        <dl class="grid gap-4 md:grid-cols-2">{c.about.facts.map((f) => <div class="rounded-card bg-teal-step p-card"><dt class="text-small">{f.label}</dt><dd><bdi>{f.value}</bdi></dd></div>)}</dl>
      </div>
    </Section>
  )}

  {kind === 'areas' && (
    <Section>
      <div class="flex flex-col gap-4">
        <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4">{c.areas.items.map((a) => <li><a href={localePath(lang, `/areas/${a.slug}`)} class={chip}>{a.name}{a.distance && <span class="text-small font-regular text-ink-soft">{a.distance}</span>}</a></li>)}</ul>
        <Text soft>{c.areas.pending}</Text>
      </div>
    </Section>
  )}

  {kind === 'area' && (
    <Section tone="teal">
      <div class="grid gap-8 md:grid-cols-2">
        <div class="flex flex-col gap-4"><Heading level={2} tone="pearl">{c.areas.servicesLabel}</Heading><ul class="flex flex-col gap-2">{c.services.items.map((s) => <li><a class="inline-flex min-h-target items-center underline underline-offset-4 transition hover:opacity-70" href={localePath(lang, `/services/${s.slug}`)}>{s.name}</a></li>)}</ul></div>
        <dl class="flex flex-col gap-4">{rows.map(([l, v]) => <div><dt class="text-small">{l}</dt><dd><bdi>{v}</bdi></dd></div>)}</dl>
      </div>
    </Section>
  )}

  {kind === 'brands' && (
    <Section>
      <div class="flex flex-col gap-6">
        <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4">{c.brands.items.map((b) => <li><a href={localePath(lang, `/brands/${b.slug}`)} class={chip}>{b.name}</a></li>)}</ul>
        <Text soft>{c.brands.disclaimer}</Text>
      </div>
    </Section>
  )}

  {kind === 'contact' && (
    <Section>
      <div class="grid gap-8 md:grid-cols-2">
        <LeadForm />
        <dl class="flex flex-col gap-4">{rows.map(([l, v]) => <div><dt class="text-small text-ink-soft">{l}</dt><dd><bdi>{v}</bdi></dd></div>)}</dl>
        <div><Button variant="quiet" href={site.maps.listing} data-action="directions">{actions.directions}</Button></div>
        <ShopMap />
      </div>
    </Section>
  )}

  {kind === 'reviews' && <Section><Reviews /></Section>}

  {kind === 'work' && photos.length === 0 && <Section><Text>{c.work.empty}</Text></Section>}

  {(kind === 'work' || kind === 'about') && photos.length > 0 && (
    <Section>
      <ul class="grid grid-cols-2 gap-4 lg:grid-cols-12 lg:gap-8">
        {photos.map((p) => {
          const w = sizeOf(p.photo);
          const wide = w > 400;
          return (
            <li class:list={['flex flex-col items-center gap-2 *:w-full', wide ? 'col-span-2 lg:col-span-6' : 'lg:col-span-3']}>
              <Img name={p.photo} widths={wide ? [340, w] : [w]} width={w} height={wide ? 382 : 510} alt={p.caption} sizes="(min-width: 64rem) 40vw, 50vw" rounded job />
              <p class="text-center text-small text-balance">{p.caption}</p>
            </li>
          );
        })}
      </ul>
    </Section>
  )}

  {kind === 'blog' && (
    <Section>
      <ul class="grid gap-4 md:grid-cols-2">{c.blog.items.map((p) => <li><a href={localePath(lang, `/blog/${p.slug}`)} class={tile}>{p.h1}<span class="text-small font-regular text-ink-soft">{p.lead}</span></a></li>)}</ul>
    </Section>
  )}

  <Guide guide={g} />

  {kind === 'post' && (
    <Section>
      <div class="flex flex-wrap gap-3"><Button variant="whatsapp">{actions.whatsapp}</Button><Button variant="quiet" href={localePath(lang, '/blog')}>{c.blog.h1}</Button></div>
    </Section>
  )}
</Base>
