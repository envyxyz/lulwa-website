---
import Button from './Button.astro';
import Heading from './Heading.astro';
import Section from './Section.astro';
import Text from './Text.astro';
import { art } from './appliance-art';
import Base from '../layouts/Base.astro';
import { content, langFromUrl, localePath } from '../content';

type Props = { slug: string };
const lang = langFromUrl(Astro.url);
const { services, faults, actions } = content[lang];
const s = services.items.find((i) => i.slug === Astro.props.slug)!;
const related = faults.items.filter((f) => f.service === s.slug);
const drawing = art[related[0]?.art ?? 'split-ac']!;
const list = 'flex flex-col gap-2 ps-card list-disc marker:text-teal';
---

<Base title={s.seo.title} description={s.seo.description}>
  <Section>
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="flex flex-col items-start gap-4 lg:col-span-7">
        <Heading level={1}>{s.h1}</Heading>
        <Text size="lead">{s.lead}</Text>
        <Text>{s.forWho}</Text>
        <div class="flex flex-wrap gap-3"><Button variant="whatsapp">{actions.whatsapp}</Button><Button variant="call">{actions.call}</Button></div>
        <Button variant="quiet" href={localePath(lang, '/services')}>{actions.allServices}</Button>
      </div>
      <svg viewBox="0 0 200 150" role="img" aria-label={services.labels.art} class="h-auto w-full self-start rounded-panel bg-white fill-none stroke-teal stroke-2 p-card lg:col-span-5" set:html={drawing.svg} />
    </div>
  </Section>
  <Section tone="teal">
    <div class="grid gap-8 md:grid-cols-2">
      <div class="flex flex-col gap-4"><Heading level={2} tone="pearl">{services.labels.units}</Heading><ul class={list}>{s.units.map((u) => <li>{u}</li>)}</ul></div>
      <div class="flex flex-col gap-4 rounded-card bg-teal-step p-card"><h2 class="font-display text-head font-head">{s.send.h}</h2><ul class={list}>{s.send.items.map((i) => <li>{i}</li>)}</ul></div>
    </div>
  </Section>
  {related.length > 0 && (
    <Section>
      <div class="flex flex-col gap-4">
        <Heading>{services.labels.faults}</Heading>
        <ul class="flex flex-wrap gap-3">{related.map((f) => <li><a href={localePath(lang, `/faults/${f.slug}`)} class="inline-flex min-h-target items-center rounded-button bg-pearl-step px-card font-medium">{f.name}</a></li>)}</ul>
      </div>
    </Section>
  )}
  <Section>
    <div class="flex flex-col gap-4">
      <Heading>{services.labels.faq}</Heading>
      <dl class="flex flex-col gap-4">{s.faq.map((q) => <div class="grid gap-2 md:grid-cols-2 md:gap-8"><dt class="font-display text-lead font-head">{q.q}</dt><dd class="text-ink-soft">{q.a}</dd></div>)}</dl>
    </div>
  </Section>
</Base>
