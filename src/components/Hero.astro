---
import Button from './Button.astro';
import Icon from './Icon.astro';
import Img from './Img.astro';
import { site } from '../site';
import { content, langFromUrl, localePath } from '../content';

const lang = langFromUrl(Astro.url);
const { actions, home, services } = content[lang];
const { hero, shop } = home;
const ac = services.items[0]!;
---

<section data-tone="teal" class="px-gutter">
  <div class="@container relative flex flex-col overflow-clip rounded-panel bg-teal text-pearl">
    <div class="flex flex-col gap-8 p-card md:flex-row md:items-center md:justify-between md:py-section">
      <div class="flex max-w-text flex-col gap-4">
        <h1 class="font-display text-statement font-statement tracking-statement">{hero.question}<br />{hero.service}</h1>
        <p>{hero.support}</p>
        <!-- homeVisitLine replaces the answer once the client confirms home visits. -->
        <p class="text-lead font-medium">{hero.homeVisitLine || hero.answer}<span class="ms-1 inline-block size-pearl rounded-dot bg-copper" aria-hidden="true"></span></p>
        <div class="flex flex-wrap gap-3 *:grow md:*:grow-0">
          <Button variant="whatsapp">{actions.whatsapp}</Button>
          <Button variant="call" light>{actions.call}</Button>
        </div>
        <p class="text-small"><bdi dir="ltr">{site.phone.display}</bdi><br />{shop.hours}</p>
      </div>
      <a href={localePath(lang, `/services/${ac.slug}`)} class="flex w-full shrink-0 items-center gap-4 rounded-card bg-white p-4 text-ink transition hover:scale-102 active:scale-98 md:w-tile md:flex-col md:items-stretch md:gap-2">
        <span class="w-28 shrink-0 md:w-full"><Img name="split-ac-indoor" widths={[320, 640]} width={640} height={478} alt={hero.tile.alt} sizes="(min-width: 48rem) 17rem, 7rem" eager /></span>
        <span class="flex grow items-center justify-between font-medium">{ac.name}<Icon name="arrow-next" /></span>
      </a>
    </div>
  </div>
</section>
