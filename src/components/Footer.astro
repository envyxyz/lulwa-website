---
import { site } from '../site';
import { content, langFromUrl, localePath } from '../content';

const lang = langFromUrl(Astro.url);
const c = content[lang];
const { home } = c;
const links = [
  ['/about', c.about.h1],
  ['/areas', c.areas.h1],
  ['/brands', c.brands.h1],
  ['/work', c.work.h1],
  ['/blog', c.blog.h1],
  ['/privacy-policy', c.legal.privacy.h1],
  ['/terms-of-service', c.legal.terms.h1],
  ['/cookie-policy', c.legal.cookies.h1],
] as const;
const { shop } = home;
const rows = [
  [shop.addressLabel, shop.address],
  [shop.hoursLabel, shop.hours],
  [shop.legalLabel, site.legal.name],
  [shop.crLabel, site.legal.cr],
];
---

<footer data-tone="ink" class="bg-ink py-section text-pearl">
  <div class="px-gutter">
    <a href={site.phone.tel} data-action="call" class="font-display text-head font-head transition active:opacity-60"><bdi dir="ltr">{site.phone.display}</bdi></a>
    <dl class="mt-8 grid gap-6 md:grid-cols-2 lg:flex lg:justify-between">
      {rows.map(([label, value]) => <div><dt class="text-small">{label}</dt><dd><bdi>{value}</bdi></dd></div>)}
    </dl>
    <ul class="mt-8 flex flex-wrap gap-x-6">{links.map(([path, label]) => <li><a href={localePath(lang, path)} class="inline-flex min-h-target items-center text-small underline underline-offset-4">{label}</a></li>)}</ul>
  </div>
</footer>

