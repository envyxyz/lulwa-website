---
import { site } from '../site';
import { content, langFromUrl } from '../content';

const { chrome, home } = content[langFromUrl(Astro.url)];
const { shop } = home;
const rows = [
  [shop.addressLabel, shop.address],
  [shop.hoursLabel, shop.hours],
  [shop.legalLabel, site.legal.name],
  [shop.crLabel, site.legal.cr],
];
---

<footer data-tone="ink" class="@container overflow-clip bg-ink pt-section text-pearl">
  <div class="px-gutter">
    <a href={site.phone.tel} data-action="call" class="font-display text-head font-head transition active:opacity-60"><bdi dir="ltr">{site.phone.display}</bdi></a>
    <dl class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {rows.map(([label, value]) => <div><dt class="text-small">{label}</dt><dd><bdi>{value}</bdi></dd></div>)}
    </dl>
  </div>
  <p aria-hidden="true" class="crop mt-8 text-center font-display text-giant font-statement tracking-statement text-teal-quiet">{chrome.word}</p>
</footer>

<style>
  .crop {
    block-size: 0.62em;
  }
</style>
