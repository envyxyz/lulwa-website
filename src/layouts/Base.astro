---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import FloatActions from '../components/FloatActions.astro';
import { site } from '../site';
import { content, isEnglishRoot, langFromUrl } from '../content';
import { alternates, breadcrumbs, business, carriesBusiness, isoDate, pageNodes } from '../seo';

type Props = { title: string; description: string; noindex?: boolean; ld?: object[]; image?: { src: string; width: number; height: number; alt: string } | undefined };
const { title, description, noindex = false, ld = [], image } = Astro.props;
const lang = langFromUrl(Astro.url);
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const alt = alternates(Astro.url.pathname);
const canonical = lang === 'ar' ? alt.ar : alt.en ?? alt.ar;
const englishOnly = isEnglishRoot(alt.path);
// An Arabic-only post has no English twin: no en-SA hreflang, no alternate locale.
const arabicOnly = !alt.en;
const home = alt.path === '/' || alt.path === '/en';
const shortTitle = title.split(' | ')[0]!;
const graph = [...(carriesBusiness(Astro.url.pathname) ? [business(lang)] : []), ...pageNodes(lang, Astro.url.pathname, title, description), ...(home ? [] : [breadcrumbs(lang, Astro.url.pathname, shortTitle)]), ...ld];
// Posts carry their date: article:modified_time and the article type.
const postSlug = alt.arPath.startsWith('/blog/') ? alt.arPath.slice(6) : undefined;
const post = postSlug ? content[lang].blog.items.find((p) => p.slug === postSlug) : undefined;
const modified = post && isoDate(post.updated);
// A post's featured image is its share image; every other page shares the logo card.
const ogImage = `${site.url}${encodeURI(image?.src ?? site.images.og)}`;
const ogAlt = image?.alt ?? (lang === 'ar' ? `شعار ${site.brand.arabic}` : `${site.brand.english} logo`);
const businessName = lang === 'ar' ? site.brand.arabic : site.brand.english;
const rss = lang === 'ar' ? '/blog/rss.xml' : '/en/blog/rss.xml';
// Everything the first paint needs, so no font waits for the stylesheet to be parsed.
const preloadFonts = lang === 'ar' ? ['beiruti-800-900', 'plex-arabic-400', 'plex-arabic-500'] : ['schibsted-400-800'];
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={site.theme.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={site.theme.dark} media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.brand.english} />
    <meta name="google-site-verification" content={site.verification.google} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {!englishOnly && <link rel="alternate" hreflang="ar-SA" href={alt.ar} />}
    {alt.en && <link rel="alternate" hreflang="en-SA" href={alt.en} />}
    <link rel="alternate" hreflang="x-default" href={englishOnly ? canonical : alt.ar} />
    <link rel="alternate" type="application/rss+xml" title={businessName} href={rss} />
    <link rel="alternate" type="text/plain" href="/llms.txt" />
    <meta name="geo.region" content={site.address.regionCode} />
    <meta name="geo.placename" content={site.address[lang].city} />
    <meta name="geo.position" content={`${site.geo.latitude};${site.geo.longitude}`} />
    <meta name="ICBM" content={`${site.geo.latitude}, ${site.geo.longitude}`} />
    <meta property="og:type" content={post ? 'article' : 'website'} />
    <meta property="og:site_name" content={businessName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : 'en_US'} />
    {!englishOnly && !arabicOnly && <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_SA'} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={image ? 'image/webp' : 'image/png'} />
    <meta property="og:image:width" content={String(image?.width ?? 1200)} />
    <meta property="og:image:height" content={String(image?.height ?? 630)} />
    <meta property="og:image:alt" content={ogAlt} />
    {modified && <meta property="article:modified_time" content={modified} />}
    {modified && <meta property="article:published_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="msapplication-TileColor" content={site.theme.tile} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
    {preloadFonts.map((f) => <link rel="preload" href={`/fonts/${f}.woff2`} as="font" type="font/woff2" crossorigin />)}
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only">{content[lang].chrome.skipLink}</a>
    <TopBar />
    <main id="main"><slot /></main>
    <Footer />
    <FloatActions home={home} />
    <script>
      import '../scripts/chrome';
    </script>
  </body>
</html>
