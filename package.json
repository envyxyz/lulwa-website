{
  "name": "lulwa-website",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "lenis": "^1.3.27",
    "motion": "^14.9.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "lucide-static": "^1.65.0",
    "postcss-html": "^2.0.0",
    "sharp": "^0.35.5",
    "simple-icons": "^16.36.0",
    "stylelint": "^17.16.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/redirects.mjs && astro build && node scripts/postbuild.mjs && node scripts/cms-preview.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint . && stylelint \"src/**/*.{css,astro}\"",
    "test:lint-proof": "node scripts/prove-lint.mjs",
    "test:photos": "node scripts/check-photos.mjs",
    "test:taste": "node scripts/taste.mjs",
    "test:lighthouse": "node scripts/lighthouse.mjs && lhci assert --config=lighthouserc.cjs",
    "test:e2e": "playwright test",
    "test:contract": "node scripts/test-contract.mjs",
    "package": "pnpm build && node scripts/package-hostinger.mjs",
    "pages": "node scripts/pages-base.mjs",
    "serve": "node scripts/serve-apache.mjs dist",
    "test:guides": "node scripts/check-guides.mjs"
  }
}
